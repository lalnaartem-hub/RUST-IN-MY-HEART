<Window x:Class="AdvancedRAT.UI.ClientConsole.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helix="http://helix-toolkit.org/wpf/Controls"
        xmlns:local="clr-namespace:AdvancedRAT.UI.ClientConsole"
        mc:Ignorable="d"
        Title="AdvancedRAT Dashboard" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen"
        Background="#FF2D2D30">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#FF007ACC" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="AdvancedRAT v12" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text=" | " FontSize="24" Foreground="White" Margin="5,0"/>
                <TextBlock x:Name="connectionStatus" Text="Disconnected" FontSize="16" Foreground="Red"/>
            </StackPanel>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#FF3E3E42" Margin="5">
                <StackPanel>
                    <Button Content="System Info" Style="{StaticResource SidebarButton}" Tag="systemInfo" Click="SidebarButton_Click"/>
                    <Button Content="Live View" Style="{StaticResource SidebarButton}" Tag="liveView" Click="SidebarButton_Click"/>
                    <Button Content="File Manager" Style="{StaticResource SidebarButton}" Tag="fileManager" Click="SidebarButton_Click"/>
                    <Button Content="Keylogger" Style="{StaticResource SidebarButton}" Tag="keylogger" Click="SidebarButton_Click"/>
                    <Button Content="Trolling" Style="{StaticResource SidebarButton}" Tag="trolling" Click="SidebarButton_Click"/>
                    <Button Content="Stealer" Style="{StaticResource SidebarButton}" Tag="stealer" Click="SidebarButton_Click"/>
                    <Button Content="Persistence" Style="{StaticResource SidebarButton}" Tag="persistence" Click="SidebarButton_Click"/>
                    <Button Content="Security" Style="{StaticResource SidebarButton}" Tag="security" Click="SidebarButton_Click"/>
                </StackPanel>
            </Border>
            
            <!-- Main Panel -->
            <Border Grid.Column="1" Background="#FF252526" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Toolbar -->
                    <Border Grid.Row="0" Background="#FF3C3C41" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Screenshot" Margin="2" Padding="10,5" Click="TakeScreenshot_Click"/>
                            <Button Content="Webcam" Margin="2" Padding="10,5" Click="TakeWebcamShot_Click"/>
                            <Button Content="Microphone" Margin="2" Padding="10,5" Click="RecordMicrophone_Click"/>
                            <Button Content="Kill Process" Margin="2" Padding="10,5" Click="KillProcess_Click"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Content Area -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="contentArea">
                            <!-- Dynamic content will be loaded here -->
                            <TextBlock Text="Welcome to AdvancedRAT Dashboard" 
                                       FontSize="18" 
                                       Foreground="White" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Margin="20"/>
                            
                            <!-- 3D Globe Visualization -->
                            <helix:HelixViewport3D x:Name="globeViewPort" Height="300" Margin="10">
                                <helix:SunLight/>
                                <helix:MeshGeometryVisual3D>
                                    <helix:MeshGeometryVisual3D.Geometry>
                                        <MeshGeometry3D Positions="-1,-1,0 1,-1,0 1,1,0 -1,1,0" 
                                                        TriangleIndices="0 1 2 2 3 0" 
                                                        TextureCoordinates="0,1 1,1 1,0 0,0"/>
                                    </helix:MeshGeometryVisual3D.Geometry>
                                    <helix:MeshGeometryVisual3D.Material>
                                        <DiffuseMaterial Brush="Blue"/>
                                    </helix:MeshGeometryVisual3D.Material>
                                </helix:MeshGeometryVisual3D>
                            </helix:HelixViewport3D>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Footer -->
        <Border Grid.Row="2" Background="#FF3E3E42" Padding="5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status:" Foreground="White"/>
                <TextBlock x:Name="statusText" Text="Ready" Foreground="LimeGreen" Margin="5,0"/>
                <TextBlock Text="" Foreground="White" Margin="20,0,0,0"/>
                <TextBlock x:Name="victimInfo" Text="Victim: Unknown" Foreground="Yellow"/>
            </StackPanel>
        </Border>
    </Grid>
    
    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF007ACC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>